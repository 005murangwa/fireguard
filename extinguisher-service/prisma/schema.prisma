generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ExtinguisherStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
}

model Extinguisher {
  id               Int                @id @default(autoincrement())
  clientId         Int
  serialNumber     String             @unique @db.VarChar(100)
  extinguisherType String             @db.VarChar(100)
  quantity         Int                @default(1)
  purchaseDate     DateTime
  expiryDate       DateTime
  status           ExtinguisherStatus @default(ACTIVE)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([clientId])
  @@index([expiryDate])
  @@index([status])
  @@map("extinguishers")
}
