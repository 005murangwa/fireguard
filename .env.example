# Shared MySQL connection (XAMPP default: root with no password)
DATABASE_URL=mysql://root:@localhost:3306/fire_extinguisher_mgmt

# Database setup script (used by npm run db:setup)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=

# JWT (must match across api-gateway and auth-service)
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# Resend email (optional - logs to console when not set)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Notification cron (default: daily at 8:00 AM)
CRON_SCHEDULE=0 8 * * *
