# =============================================================================
# FireGuard LTD — Notification Service Environment Variables
# Copy to .env (or run `npm run env:setup` from repo root).
# =============================================================================

PORT=5006
DATABASE_URL=mysql://root:@localhost:3306/fireguard_ltd
JWT_SECRET=super-secret-jwt-key-change-in-production

# Upstream microservice URLs used by cron + email resolution
FIRE_EXTINGUISHER_SERVICE_URL=http://localhost:5003
INSPECTION_SERVICE_URL=http://localhost:5004
MAINTENANCE_SERVICE_URL=http://localhost:5005
USER_SERVICE_URL=http://localhost:5002

# SMTP (nodemailer) — leave blank to log [DEV EMAIL] to console instead
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Daily cron schedule (node-cron syntax) — default 08:00 every day
CRON_SCHEDULE=0 8 * * *
