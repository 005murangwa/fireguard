# ---------------------------------------------------------------------------
# FireGuard LTD — Auth Service Environment Variables
# Copy this file to `.env` and adjust values for your local machine.
# ---------------------------------------------------------------------------

# HTTP port for the auth microservice (API Gateway proxies to this port)
PORT=5001

# MySQL connection string — shared monorepo database (see database/init.sql)
DATABASE_URL=mysql://root:@localhost:3306/fireguard_ltd

# Secret used to sign and verify JWT access tokens (MUST change in production)
JWT_SECRET=super-secret-jwt-key-change-in-production

# Token lifetime passed to jsonwebtoken.sign (e.g. 24h, 7d)
JWT_EXPIRES_IN=24h

# ---------------------------------------------------------------------------
# SMTP (optional) — OTP emails are sent via nodemailer when configured.
# If SMTP_HOST / SMTP_USER / SMTP_PASS are missing, emails log to console.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=FireGuard LTD <noreply@fireguard.com>

# Downstream notification microservice (used for future cross-service hooks)
NOTIFICATION_SERVICE_URL=http://localhost:5006
